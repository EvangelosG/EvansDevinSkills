# Everything app-specific about this skill lives here; the scripts stay generic.
# Edit these five values for the repo you are dropping the skill into.
# Environment variables win over what is set here.

APP_MODULE="${APP_MODULE:-:app}"
VARIANT="${VARIANT:-Debug}"              # capitalised; flavoured projects use e.g. "DemoDebug"
UNIT_TASKS="${UNIT_TASKS:-}"             # empty = <APP_MODULE>:test<VARIANT>UnitTest
PAUSE_ARG="${PAUSE_ARG:-demoPauseMs}"    # instrumentation arg the UI tests read to slow down for the camera
AVD="${AVD:-}"                           # empty = the first installed AVD

# Example — nowinandroid, which has demo/prod flavors and unit tests worth showing in two modules:
#   VARIANT="DemoDebug"
#   UNIT_TASKS=":core:domain:testDemoDebugUnitTest :feature:search:impl:testDemoDebugUnitTest"
